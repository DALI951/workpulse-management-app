datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String      @id @default(cuid())
  username     String
  email        String      @unique
  passwordHash String
  role         String      @default("COLLABORATOR") // "ADMIN" or "COLLABORATOR"
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  projects     Project[]   @relation("CollaboratorProjects")
}

model Project {
  id             String      @id @default(cuid())
  name           String
  description    String?
  responsibleId  String
  responsible    User        @relation("CollaboratorProjects", fields: [responsibleId], references: [id], onDelete: Cascade)
  tasks          Task[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Task {
  id          String      @id @default(cuid())
  title       String
  description String?
  status      String      @default("PENDING") // "PENDING", "IN_PROGRESS", "COMPLETED"
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}
